rules_version = '2';

// The Tavern — security rules. Paste this whole file in Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per username: the account key, encrypted twice (password and recovery code).
    // Anyone may read ONE login by its exact username (needed to sign in), nobody may list them.
    match /logins/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_-]{3,20}$')
        && request.auth.token.email == name + '@players.tavern.local'
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Each tool's records for each person: tools/<tool>/<user id>/<record>. Only that person can read or write them.
    match /tools/{tool}/{uid}/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
